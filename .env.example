# This file contains non-secret settings only. Inject ADMIN_PASSWORD,
# R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, CLOUDFLARE_API_TOKEN, and any
# R2_CREDENTIAL_<NORMALIZED_REF>_* values through deployment Secret env.
COOKIE_SECURE=false
DATA_DIRECTORY=./data
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCOUNT_ID=<account-id>
CLOUDFLARE_QUEUE_ID=<queue-id>
QUEUE_VISIBILITY_TIMEOUT_MS=60000
QUEUE_BATCH_SIZE=10
RECONCILE_INTERVAL_SECONDS=3600
INCREMENTAL_WORKER_CONCURRENCY=2
BACKFILL_PAGE_SIZE=1000

# Backward-compatible default. Change only this value to opt in to rclone.
R2_TRANSFER_ADAPTER=boto3
RCLONE_BINARY_PATH=/usr/local/bin/rclone
# Valid range: 1-86400 seconds.
RCLONE_TRANSFER_TIMEOUT_SECONDS=3600
# Valid range: 1024-1048576 bytes.
RCLONE_OUTPUT_LIMIT_BYTES=65536
# Valid range: 0-100.
RCLONE_LOW_LEVEL_RETRIES=3
