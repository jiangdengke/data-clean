# Never commit real secret values. Inject these through deployment secret management.
ADMIN_PASSWORD=replace-this-local-password
COOKIE_SECURE=false
DATA_DIRECTORY=./data
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Legacy/default deployment credential reference:
R2_ACCESS_KEY_ID=replace-with-deployment-secret
R2_SECRET_ACCESS_KEY=replace-with-deployment-secret
# Additional UI credential refs use R2_CREDENTIAL_<NORMALIZED_REF>_ACCESS_KEY_ID/SECRET_ACCESS_KEY.
# Example for credential_ref=team_a:
# R2_CREDENTIAL_TEAM_A_ACCESS_KEY_ID=replace-with-deployment-secret
# R2_CREDENTIAL_TEAM_A_SECRET_ACCESS_KEY=replace-with-deployment-secret
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_QUEUE_ID=replace-with-queue-id
CLOUDFLARE_API_TOKEN=replace-with-queues-read-write-token
QUEUE_VISIBILITY_TIMEOUT_MS=60000
QUEUE_BATCH_SIZE=10
RECONCILE_INTERVAL_SECONDS=3600
INCREMENTAL_WORKER_CONCURRENCY=2
BACKFILL_PAGE_SIZE=1000
